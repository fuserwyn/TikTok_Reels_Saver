# Как WAV-бот на Pyrogram: токен + api_id + api_hash обязательны
# TELEGRAM_API_KEY=   или  BOT_TOKEN=
# API_ID=
# API_HASH=

# PostgreSQL (Railway подставляет при подключении плагина БД к проекту)
# DATABASE_URL=postgresql://...
# Локально без SSL: DATABASE_SSL=false
# CERTIFICATE_VERIFY_FAILED при старте: DATABASE_SSL=no-verify
# STATS_ADMIN_IDS=123456789,987654321   # кто может /stats в личке (Telegram user id)

# MAX_UPLOAD_BYTES — опционально; для личной сессии см. bot/main.py (авто-подъём лимита).
# Лимит скачивания с TikTok/Reels до сжатия под ~50 МБ: по умолчанию max(MAX_UPLOAD_BYTES, ~450 МБ).
# MAX_DOWNLOAD_BYTES=524288000

# Видео >50 МБ: строка сессии Pyrogram (не Telethon). Локально: Client(..., phone_number=...).start() → client.export_session_string()
# Аккаунт сессии должен иметь право писать пользователю в личку при необходимости.
# TELEGRAM_SESSION=

# Видео для iPhone: по умолчанию «умный» перекод — если файл уже H.264+yuv420p,
# делаем только дешёвый faststart; иначе полный перекод H.264+AAC (иначе «картинка стоит, звук идёт»).
# Для экономии CPU на Railway: VIDEO_LIGHTWEIGHT=1 — всегда только faststart, без перекода.
# VIDEO_FORCE_TRANSCODE=1 — наоборот, всегда полный перекод (выключает «умный» пропуск).
# VIDEO_SKIP_FASTSTART=1 — даже в lightweight не делать faststart
# Старый флаг VIDEO_TRANSCODE_IOS=0 — то же что VIDEO_LIGHTWEIGHT (без перекода)

# Защита ресурсов хостинга:
# MAX_CONCURRENT_JOBS=2     # сколько скачиваний+ffmpeg параллельно (по умолчанию 2)
# DB_POOL_MAX_SIZE=4        # потолок коннектов к PostgreSQL (по умолчанию 4)
# FFMPEG_THREADS=1          # потолок потоков ffmpeg (защита от тротлинга на vCPU-лимите; пусто = авто)
# FFMPEG_PRESET=veryfast    # ultrafast..veryslow — меньше CPU ⇄ меньше размер (по умолчанию veryfast)

# Netscape cookies.txt — TikTok/Reels/Instagram с IP хостинга часто без этого не качаются
# YT_DLP_COOKIEFILE=/data/cookies.txt
# INSTAGRAM_APP_ID=936619743392459   # опционально, другой X-IG-App-ID (wiki yt-dlp → instagram)
# YouTube: набор player-клиентов yt-dlp (через запятую). По умолчанию default,-web —
# отбрасывает web-клиент, который триггерит «Sign in to confirm you're not a bot» / 429.
# YOUTUBE_PLAYER_CLIENT=default,-web
# Фоновое автообновление yt-dlp раз в N часов (0/пусто = выключено)
# YT_DLP_AUTOUPDATE_HOURS=24
